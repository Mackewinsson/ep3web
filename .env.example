# Set to "true" to show the photo gallery, "false" to show social media links instead.
ENABLE_PHOTO_GALLERY=true
NEXT_PUBLIC_ENABLE_PHOTO_GALLERY=true
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/transportesep3/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@transportes.ep3

# ── Panel ops (JWT + Neon) ────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string

# First staff user (npm run db:seed)
ADMIN_EMAIL=admin@transportesep3.cl
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin EP3

# Resend — later
# RESEND_API_KEY=
# EMAIL_FROM=Transportes EP3 <onboarding@resend.dev>
